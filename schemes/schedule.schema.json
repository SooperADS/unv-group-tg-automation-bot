{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$defs": {
		"comment-prop": {
			"type": "string",
			"title": "Комментарий",
			"description": "Используйте это свойство для пометок в JSON"
		},
		"exam-kind": {
			"description": "\"simple\" - обычный зачёт\n\"diff\" - дифференцированный зачёт\n\"full\" - экзамен\nnull - неизвестно",
			"enum": [ "simple", "full", "diff", null ]
		},
		"lesson-kind": {
			"description": "\"lecture\" - лекция\n\"practice\" - практика\n\"consultation\" - консультация\n\"exam\" - экзамен",
			"enum": [ "lecture", "practice", "consultation", "exam" ]
		},
		"id": {
			"minLength": 1,
			"maxLength": 16,
			"pattern": "^[A-Za-z0-9\\-]*$"
		},
		"link": {
			"type": "string",
			"pattern": "^https?:\/\/[-a-zA-Z0-9@:%._\\/+~#=]{1,256}$"
		},
		"link?": {
			"oneOf": [
				{
					"$ref": "#/$defs/link"
				},
				{
					"type": "null"
				}
			]
		},
		"timing": {
			"type": "string",
			"minLength": 1,
			"maxLength": 5,
			"pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"
		},
		"uuid": {
			"type": "string",
			"minLength": 36,
			"maxLength": 36,
			"pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
		},
		"string?": {
			"oneOf": [
				{
					"type": "string"
				},
				{
					"type": "null"
				}
			]
		},
		"lesson": {
			"type": "array",
			"minItems": 2,
			"maxItems": 2,
			"prefixItems": [
				{
					"$ref": "#/$defs/id"
				},
				{
					"$ref": "#/$defs/lesson-kind"
				}
			]
		},

		"subject": {
			"type": "object",
			"title": "Описатель дисциплины",
			"properties": {
				"$comment": {
					"$ref": "#/$defs/comment-prop"
				},
				"chat": {
					"title": "Ссылка на чат предмета",
					"oneOf": [
						{
							"$ref": "#/$defs/link?"
						},
						{
							"type": "object",
							"properties": {
								"$comment": {
									"$ref": "#/$defs/comment-prop"
								},
								"main": {
									"$ref": "#/$defs/link?"
								},
								"lecture": {
									"$ref": "#/$defs/link?"
								},
								"practice": {
									"$ref": "#/$defs/link?"
								}
							},
							"additionalProperties": false
						}
					]
				},
				"name": {
					"type": "string",
					"title": "Имя предмета"
				},
				"tag": {
					"type": "string",
					"title": "Тег предмета",
					"pattern": "^[-A-Za-z0-9А-Яа-яЁё]+$"
				},
				"exam": {
					"title": "Информация об экзамене",
					"type": "object",
					"properties": {
						"$comment": {
							"$ref": "#/$defs/comment-prop"
						},
						"kind": {
							"title": "Тип экзамена",
							"$ref": "#/$defs/exam-kind"
						},
						"requirements": {
							"title": "Требования к сдачи экзамена",
							"description": "Если null - требования неизвестны",
							"$ref": "#/$defs/string?"
						},
						"form": {
							"title": "Форма сдачи экзамена",
							"description": "Если null - неизвестно",
							"$ref": "#/$defs/string?"
						}
					},
					"additionalProperties": false,
					"required": [ "kind" ]
				}
			},
			"additionalProperties": false,
			"required": [ "name", "tag", "exam" ]
		},
		"day": {
			"type": "array",
			"minItems": 1,
			"items": {
				"title": "Пары за день",
				"oneOf": [
					{
						"$ref": "#/$defs/lesson"
					},
					{
						"type": "null"
					}
				]
			}
		},
		"week": {
			"type": "array",
			"minItems": 1,
			"maxItems": 7,
			"items": {
				"oneOf": [
					{
						"$ref": "#/$defs/day"
					},
					{
						"type": "null"
					}
				]
			}
		},

		"week-ref": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "array",
					"$ref": "#/$defs/week"
				},
				{
					"type": "string",
					"$ref": "#/$defs/id"
				}
			]
		},
		"schedule-note": {
			"type": "object",
			"properties": {
				"$comment": {
					"$ref": "#/$defs/comment-prop"
				},
				"pattern": {
					"type": "array",
					"title": "Недели, которые будут повторятся",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/week-ref"
					}
				},
				"count": {
					"type": "integer",
					"title": "Количество повторов",
					"minimum": 1
				}
			},
			"additionalProperties": false,
			"required": [ "count", "pattern" ]
		}
	},

	"type": "object",
	"properties": {
		"$comment": {
			"$ref": "#/$defs/comment-prop"
		},
		"$schema": {
			"type": "string"
		},
		"general": {
			"type": "object",
			"properties": {
				"$comment": {
					"$ref": "#/$defs/comment-prop"
				},
				"timings": {
					"type": "object",
					"title": "Временные метки в расписании",
					"description": "Указывает дату и время событий и точек отсчёта",
					"properties": {
						"$comment": {
							"$ref": "#/$defs/comment-prop"
						},
						"lessons": {
							"type": "array",
							"title": "Временные метки начала пар",
							"minItems": 1,
							"maxItems": 16,
							"items": {
								"$ref": "#/$defs/timing"
							}
						},
						"lesson-duration": {
							"title": "Продолжительность пары",
							"$ref": "#/$defs/timing"
						},
						"first-week": {
							"type": "integer",
							"title": "Начать расписание с недели",
							"description": "Номер недели, с которой начинается отсчёт расписания (отсчёт с 0)",
							"minimum": 0,
							"maximum": 52
						},
						"first-year": {
							"type": "integer",
							"title": "Год",
							"description": "Номер года, с которой начинается отсчёт расписания",
							"minimum": 2025,
							"maximum": 2100
						}
					},
					"additionalProperties": false,
					"required": [ "lessons", "lesson-duration", "first-week", "first-year" ]
				},
				"chat": {
					"$ref": "#/$defs/link",
					"title": "Ссылка на основной чат"
				},
				"name": {
					"$ref": "#/$defs/string?",
					"title": "Имя расписания"
				}
			},
			"additionalProperties": false,
			"required": [ "timings", "chat" ]
		},
		"subjects": {
			"type": "object",
			"title": "Предметы",
			"description": "Общее описание всех предметов",
			"propertyNames": {
				"$ref": "#/$defs/id"
			},
			"additionalProperties": {
				"$ref": "#/$defs/subject"
			}
		},
		"weeks": {
			"type": "object",
			"title": "Именованные недели",
			"propertyNames": {
				"$ref": "#/$defs/id"
			},
			"additionalProperties": {
				"$ref": "#/$defs/week"
			}
		},
		"schedule": {
			"type": "array",
			"title": "Расписание (в неделях)",
			"minItems": 1,
			"items": {
				"oneOf": [
					{
						"$ref": "#/$defs/week-ref"
					},
					{
						"type": "object",
						"$ref": "#/$defs/schedule-note"
					}
				]
			}
		}
	},
	"additionalProperties": false,
	"required": [ "subjects", "general", "schedule" ]
}